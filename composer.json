{
    "name": "elstc/cakephp-reserved-slugs",
    "description": "CakePHP plugin for URL-safe slug validation and reserved-word collision prevention",
    "version": "5.0.0-rc1",
    "license": "MIT",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "slug",
        "validation"
    ],
    "authors": [
        {
            "name": "nojimage",
            "homepage": "https://github.com/elstc/cakephp-reserved-slugs/graphs/contributors"
        }
    ],
    "homepage": "https://github.com/elstc/cakephp-reserved-slugs",
    "support": {
        "issues": "https://github.com/elstc/cakephp-reserved-slugs/issues",
        "source": "https://github.com/elstc/cakephp-reserved-slugs"
    },
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.1",
        "cakephp/migrations": "^4.0 | ^5.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "ReservedSlugs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReservedSlugs\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/TestApp/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "cs-check": "phpcs --colors -p src/ tests/",
        "cs-fix": "phpcbf --colors -p src/ tests/",
        "phpstan": "tools/phpstan analyse --memory-limit=512M",
        "stan": "@phpstan",
        "stan-baseline": "tools/phpstan --generate-baseline --memory-limit=512M",
        "stan-setup": "phive install",
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-clover=clover.xml",
        "update-lowest": "composer update --prefer-lowest --prefer-stable"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
